# Build stage
FROM rust:slim AS builder

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy source
COPY code/ ./code/

WORKDIR /app/code

# Build and stage the one executable this service can run. Cargo also writes
# dependency metadata and directories under target/release, so the runtime
# image must never COPY that directory with a wildcard. Multiple binaries are
# ambiguous for cargo run as well; fail here with an actionable contract error.
RUN cargo build --release \
    && set -- $(find target/release -maxdepth 1 -type f -perm -111 -print) \
    && if [ "$#" -ne 1 ]; then \
         echo "expected exactly one release executable, found $#" >&2; \
         exit 1; \
       fi \
    && cp "$1" /app/codefly-service

# Final stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

{{ range .Envs }}
ENV {{ .Key }}={{ .Value }}
{{ end }}

RUN adduser --disabled-password --gecos '' appuser

COPY --chown=appuser --from=builder /app/codefly-service /app/app

USER appuser

EXPOSE 8080

CMD ["./app"]
